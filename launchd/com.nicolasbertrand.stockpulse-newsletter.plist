<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nicolasbertrand.stockpulse-newsletter</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nicolasbertrand/.claude/run_stock_newsletter.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>3</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/nicolasbertrand</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/nicolasbertrand/.claude/logs/stockpulse-launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/nicolasbertrand/.claude/logs/stockpulse-launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>StartOnMount</key>
    <false/>
</dict>
</plist>
